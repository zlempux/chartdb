-- Crear tabla PROVEEDORES
CREATE TABLE PROVEEDORES (
    IDPROV NUMBER PRIMARY KEY,
    NOMBRE VARCHAR2(50),
    CIUDAD VARCHAR2(30),
    PROVINCIA VARCHAR2(30),
    DIRECCION VARCHAR2(100),
    TELEFONO VARCHAR2(15),
    PAGINA_WEB VARCHAR2(100)
);

-- Crear tabla CLIENTES
CREATE TABLE CLIENTES (
    NUMCLIE NUMBER PRIMARY KEY,
    NOMBRE VARCHAR2(30),
    APELLIDO VARCHAR2(30),
    CIUDAD VARCHAR2(30),
    PROVINCIA VARCHAR2(30),
    CODPOSTAL VARCHAR2(10)
);

-- Crear tabla EMPLEADOS
CREATE TABLE EMPLEADOS (
    NUMEMP NUMBER PRIMARY KEY,
    NOMBRE VARCHAR2(30),
    APELLIDO VARCHAR2(30),
    CIUDAD VARCHAR2(30),
    TITULO VARCHAR2(30)
);

-- Crear tabla OFICINAS
CREATE TABLE OFICINAS (
    IDOFICINA NUMBER PRIMARY KEY,
    CIUDAD VARCHAR2(30),
    REGION VARCHAR2(30),
    DIR VARCHAR2(50)
);

-- Crear tabla CATEGORIAS
CREATE TABLE CATEGORIAS (
    IDCATEGORIA NUMBER PRIMARY KEY,
    DESCRIPCION VARCHAR2(50)
);

-- Crear tabla PRODUCTOS
CREATE TABLE PRODUCTOS (
    IDPRODUCTO NUMBER PRIMARY KEY,
    DESCRIPCION VARCHAR2(50),
    PRECIO NUMBER,
    EXISTENCIAS NUMBER,
    IDCATEGORIA NUMBER,
    IDPROV NUMBER,
    CONSTRAINT FK_PRODUCTOS_CATEGORIAS FOREIGN KEY (IDCATEGORIA) REFERENCES CATEGORIAS(IDCATEGORIA),
    CONSTRAINT FK_PRODUCTOS_PROVEEDORES FOREIGN KEY (IDPROV) REFERENCES PROVEEDORES(IDPROV)
);

