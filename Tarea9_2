-- Crear tabla PEDIDOS
CREATE TABLE PEDIDOS (
    IDPEDIDO NUMBER PRIMARY KEY,
    NUMCLIE NUMBER,
    IDPRODUCTO NUMBER,
    FECHAPEDIDO DATE,
    FECHAENVIO DATE,
    CANTIDAD NUMBER,
    CONSTRAINT FK_PEDIDOS_CLIENTES FOREIGN KEY (NUMCLIE) REFERENCES CLIENTES(NUMCLIE),
    CONSTRAINT FK_PEDIDOS_PRODUCTOS FOREIGN KEY (IDPRODUCTO) REFERENCES PRODUCTOS(IDPRODUCTO)
);
